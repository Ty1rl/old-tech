[connection signal="item_selected" from="Margin/Center/Panel/Stack/Scroll/Body/RoomPicker" to="." method="_on_room"]

[connection signal="item_selected" from="Margin/Center/Panel/Stack/Scroll/Body/EncounterPicker" to="." method="_on_encounter"]

[connection signal="pressed" from="Margin/Center/Panel/Stack/Scroll/Body/StartEncounter" to="." method="_launch"]

[connection signal="pressed" from="Margin/Center/Panel/Stack/Scroll/Body/SandboxButton" to="." method="_on_sandbox"]

[connection signal="pressed" from="Margin/Center/Panel/Stack/Scroll/Body/BackButton" to="." method="_on_back"]

