[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://scenes/ui/encounter_menu.gd" id="1"]
[ext_resource type="Theme" path="res://scenes/ui/museum_theme.tres" id="2"]

[node name="EncounterMenu" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
process_mode = 3
script = ExtResource("1")
theme = ExtResource("2")
panel_height = 560.0

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.03, 0.025, 0.78)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Center" type="CenterContainer" parent="Margin"]
layout_mode = 2

[node name="Panel" type="PanelContainer" parent="Margin/Center"]
unique_name_in_owner = true
layout_mode = 2

[node name="Stack" type="VBoxContainer" parent="Margin/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="VBoxContainer" parent="Margin/Center/Panel/Stack"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8


[node name="Title" type="Label" parent="Margin/Center/Panel/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Developer options"
autowrap_mode = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 34
metadata/base_font_size = 34

[node name="Subtitle" type="Label" parent="Margin/Center/Panel/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "Encounter selection and debugging"
autowrap_mode = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 17
metadata/base_font_size = 17
modulate = Color(0.706, 0.671, 0.6, 1)

[node name="Separator" type="HSeparator" parent="Margin/Center/Panel/Stack/Header"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Center/Panel/Stack"]
unique_name_in_owner = true
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/Center/Panel/Stack/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="RoomPickerLabel" type="Label" parent="Margin/Center/Panel/Stack/Scroll/Body"]
unique_name_in_owner = true
layout_mode = 2
text = "Room"
autowrap_mode = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 14
metadata/base_font_size = 14

[node name="RoomPicker" type="OptionButton" parent="Margin/Center/Panel/Stack/Scroll/Body"]
unique_name_in_owner = true
