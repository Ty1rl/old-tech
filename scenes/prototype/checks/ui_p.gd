extends SceneTree
var checks := 0
var failures: Array[String] = []
class InputSpy extends Node:
	var movement := 0
	var center_clicks := 0
	func _unhandled_input(event: InputEvent) -> void:
		if event is InputEventKey and event.pressed and event.physical_keycode == KEY_W: movement += 1
		if event is InputEventMouseButton and event.pressed: center_clicks += 1
func _initialize() -> void: call_deferred("run")
func expect(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)
func settle(count: int = 5) -> void:
	for i in range(count): await process_frame
func shot(enemy: CombatPatternEnemy, point: Vector3, charge: float = 0) -> void:
	enemy.receive_attack(&"beam",30,point,{"segment_start":point-Vector3(0,0,.12),"segment_end":point+Vector3(0,0,.12),"radius":.01,"charge":charge})
func run() -> void:
	create_timer(20,true).timeout.connect(func():failures.append("UI P watchdog");print(JSON.stringify({"status":"failed","checks":checks,"failures":failures}));quit(1))
	print("UI P: carousel setup")
	var carousel: RepairCarouselView = load("res://scenes/ui/repair_carousel.tscn").instantiate()
	var gear := WeaponEquipment.new()
	gear.spend(&"beam",gear.capacity(&"beam") * .65)
	carousel.bind_equipment(gear,&"beam",[1,2,3])
	root.add_child(carousel)
	carousel.set_model_region(Rect2(Vector2(440,180),Vector2(400,300)))
	await settle()
	expect(carousel.condition.visible and carousel.condition.tool==&"beam","Bind before ready populates the selected condition overlay")
	expect(carousel.left.tool==&"ring" and carousel.right.tool==&"cone" and carousel.left.visible and carousel.right.visible,"Three owned slots show distinct ordered neighbors")
	expect(carousel.find_children("*","SubViewport",true,false).size()==2 and carousel.condition.find_children("*","Node3D",true,false).is_empty(),"At most two side viewports; no central model is created")
	var old_model := carousel.left.model
	var arc_before := carousel.condition.arc_geometry()
	for i in range(8): carousel.bind_equipment(gear,&"beam",[1,2,3])
	expect(carousel.left.model==old_model and gear.repaired.get_connections().size()==3,"Repeated binding keeps model identity and exactly three display signal connections")
	var settings_before:WeaponConditionSettings=gear.settings
	var settings:WeaponConditionSettings=gear.settings.duplicate()
	settings.repair_steps=6;gear.settings=settings;await settle()
	expect(carousel.condition.segment_count()==6 and carousel.left.condition.segment_count()==6,"Selected and side arcs read the actual nondefault checkpoint resource")
	gear.settings=settings_before;await settle()
	expect(is_equal_approx(arc_before.start,-PI+PI/3+.08) and is_equal_approx(arc_before.end,-PI+2*PI/3-.08),"Centered repair uses the same yellow sector shape as normal HUD")
	var before := gear.capture_state()
	var chosen: Array[StringName] = []
	carousel.tool_selected.connect(func(tool:StringName):chosen.append(tool))
	carousel.left.hit_area.pressed.emit()
	expect(chosen==[&"ring"] and gear.capture_state()==before and carousel.selected==&"beam","Neighbor click only requests selection; never changes selected state or condition")
	gear.begin_repair(&"beam");gear.complete_step(&"beam");await settle()
	expect(carousel.condition.filled_segments()==2 and carousel.condition._flash>0,"Real repair signal fills the actual checkpoint with neutral feedback")
	carousel.bind_equipment(gear,&"beam",[1,2,3])
	expect(carousel.condition._flash>0,"Idempotent binding preserves repair feedback")
	gear.restore_state(before);await settle()
	expect(carousel.condition.filled_segments()==1,"World condition rewind restores the prior segments")
	expect(carousel.condition.arc_geometry()==arc_before,"Repair and rewind never shift the selected active region")
	var surface := carousel.left.model.find_children("*","MeshInstance3D",true,false)[0] as MeshInstance3D
	expect(surface.mesh.surface_get_material(0).resource_local_to_scene,"Side preview material is per-instance; source mesh material stays shared")
	var original:Node3D=RepairSidePreview.MODELS[carousel.left.tool].instantiate()
	var original_mesh:MeshInstance3D=original.find_children("*","MeshInstance3D",true,false)[0]
	expect(surface.mesh!=original_mesh.mesh and surface.mesh.surface_get_material(0)!=original_mesh.mesh.surface_get_material(0),"Preview owns its mesh/material copy without changing the source asset")
	original.free()
	carousel.bind_equipment(gear,&"ring",[1]);await settle()
	expect(not carousel.left.visible and not carousel.right.visible and carousel.condition.tool==&"ring","One owned tool has only the centered overlay")
	expect(carousel.left.viewport.render_target_update_mode==SubViewport.UPDATE_DISABLED and carousel.right.viewport.render_target_update_mode==SubViewport.UPDATE_DISABLED,"Unowned previews stop rendering")
	carousel.bind_equipment(gear,&"cone",[2,3]);await settle()
	expect(carousel.left.visible and carousel.left.tool==&"beam" and not carousel.right.visible,"Two tools show one neighbor without duplicate copies")
	var count: int=carousel.find_children("*","SubViewport",true,false).size()
	for i in range(12):carousel.bind_equipment(gear,WeaponEquipment.TOOLS[i%3],[1,2,3])
	await create_timer(.24).timeout
	expect(carousel.left.hit_area.tooltip_text=="Select "+String(carousel.left.tool),"Cached neighbor keeps correct click/tooltip identity")
	expect(carousel.find_children("*","SubViewport",true,false).size()==count,"Rapid switches reuse the same bounded viewports")
	var spy:=InputSpy.new();root.add_child(spy)
	var key:=InputEventKey.new();key.pressed=true;key.physical_keycode=KEY_W;root.push_input(key);await settle()
	var click:=InputEventMouseButton.new();click.button_index=MOUSE_BUTTON_LEFT;click.pressed=true;click.position=Vector2(640,330);root.push_input(click);await settle()
	expect(spy.movement==1 and spy.center_clicks==1,"Carousel passes movement and central repair clicks through")
	for view_size in [Vector2i(1280,800),Vector2i(640,360)]:
		root.size=view_size;await settle()
		var area:=root.get_visible_rect().size
		var region:=Rect2(area*Vector2(.35,.23),area*Vector2(.3,.42))
		carousel.set_model_region(region);await settle()
		expect(root.get_visible_rect().encloses(carousel.left.get_global_rect()) and root.get_visible_rect().encloses(carousel.right.get_global_rect()),"Side previews fit viewport "+str(view_size))
		expect(not region.intersects(carousel.left.get_global_rect()) and not region.intersects(carousel.right.get_global_rect()),"Side previews stay outside selected inspection region "+str(view_size))
		var arc:=carousel.condition.arc_geometry()
		expect(arc.radius>region.size.length()*.5,"Condition arc stays beyond all active parts/labels in region "+str(view_size))
	carousel.position=Vector2(30,20);carousel.scale=Vector2(.8,.8)
	var screen_region:=Rect2(root.get_visible_rect().size*Vector2(.35,.23),root.get_visible_rect().size*Vector2(.3,.42))
	carousel.set_model_region(screen_region);await settle()
	expect(carousel.condition.get_global_rect().is_equal_approx(screen_region),"Viewport-space selected region survives parent offset and scale")
	expect(root.get_visible_rect().encloses(carousel.left.get_global_rect()) and root.get_visible_rect().encloses(carousel.right.get_global_rect()),"Scaled parent still keeps neighbors inside viewport")
	carousel.bind_equipment(null,&"",[]);await settle()
	expect(not carousel.condition.visible and not carousel.left.visible and not carousel.right.visible and gear.repaired.get_connections().is_empty(),"Unbind hides all views and releases equipment signals")
	print("UI P: carousel teardown")
	carousel.queue_free();spy.queue_free();await settle()
	print("UI P: part/pattern setup")
	var world:=Node3D.new();root.add_child(world)
	var part:=CombatPartVisual.new();world.add_child(part);part.build(&"open",&"front",.8,StandardMaterial3D.new());part.sync(false,false,false,0)
	expect(not part.instruction.visible,"Part teaching caption is off by default")
	part.set_instruction_visible(true)
	expect(part.instruction.text=="Cut blue / Heat orange","Closed alternative exposes only its real available actions")
	part.sync(true,true,false,0)
	expect(part.instruction.text=="Charge yellow" and part.instruction.modulate==part.Style.BEAM,"Opening immediately replaces blue/orange instructions with yellow")
	part.sync(true,true,true,0)
	expect(not part.instruction.visible and part.instruction.text.is_empty(),"Finished part has no repeated instruction/damage caption")
	part.set_instruction_visible(false);part.sync(false,false,false,0)
	expect(not part.instruction.visible,"Learned part stays quiet even when state is restored")
	var enemy:=CombatPatternEnemy.new();world.add_child(enemy);enemy.configure(&"loop",Vector3.ZERO,11)
	expect(not enemy.pattern_visual.countdown.visible and not enemy.pattern_visual.link_labels[0].visible,"Live nonteaching pattern enemy is quiet by default")
	enemy.pattern_visual.set_instruction_visible(true)
	var points:Array[Vector3]=enemy.cable_world_points()
	for i in range(points.size()/2):
		enemy.receive_attack(&"ring",36,points[i*2],{"segment_start":points[i*2],"segment_end":points[i*2+1],"radius":.01,"already_hit":i>0})
	expect(enemy.pattern_open and enemy.pattern_visual.countdown.text=="Charge yellow" and enemy.pattern_visual.countdown.modulate==enemy.pattern_visual.YELLOW,"Real link cuts change caption from blue to required yellow finisher")
	var snapshot:=enemy.capture_state()
	shot(enemy,enemy.core_world_position(),1)
	expect(enemy.health<=0 and not enemy.pattern_visual.countdown.visible,"Real charged finisher removes the teaching caption")
	enemy.restore_state(snapshot)
	expect(enemy.pattern_visual.countdown.text=="Charge yellow","World restore derives caption from restored actual phase")
	enemy.configure(&"final_boss",Vector3.ZERO,12);enemy.pattern_visual.set_instruction_visible(true)
	expect(enemy.pattern_visual.countdown.text=="A then B","Pair phase uses actual A then B instruction")
	shot(enemy,enemy.valve_world_position(0))
	expect(enemy.pattern_visual.countdown.text=="Then B","First real valve hit asks for current B target")
	shot(enemy,enemy.valve_world_position(1));shot(enemy,enemy.core_world_position(),1)
	expect(enemy.phase==1 and not enemy.pattern_visual.countdown.visible,"Rebuilt boss phase defaults quiet until teaching owner opts in")
	enemy.pattern_visual.set_instruction_visible(true)
	expect(enemy.pattern_visual.countdown.text=="Cut blue","New actual zigzag phase asks for blue, not prior yellow")
	enemy.debug_set_phase(3);enemy.pattern_visual.set_instruction_visible(true)
	expect(enemy.pattern_visual.countdown.text=="Charge yellow","Actual bare-core phase shows yellow only")
	enemy.pattern_visual.set_instruction_visible(false)
	expect(not enemy.pattern_visual.countdown.visible,"Learned pattern hides captions but keeps core geometry visible")
	print("UI P: world teardown")
	world.queue_free();await settle()
	print(JSON.stringify({"status":"passed" if failures.is_empty() else "failed","checks":checks,"failures":failures}));quit(0 if failures.is_empty() else 1)
