autowrap_mode = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 34
metadata/base_font_size = 34

[node name="Subtitle" type="Label" parent="Margin/Center/Panel/Stack/Header"]
unique_name_in_owner = true
layout_mode = 2
