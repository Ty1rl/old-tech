extends SceneTree
const Equipment = preload("res://scenes/prototype/equipment.gd")
var checks := 0
var failures: Array[String] = []
func _initialize() -> void: call_deferred("run")
func expect(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)
func run() -> void:
	var gear: WeaponEquipment = Equipment.new()
	var other := WeaponEquipment.new()
	expect(gear.TOOLS == [&"ring", &"beam", &"cone"] and gear.capacity(&"clock") == 0, "Only three weapon conditions exist")
	expect(gear.begin_repair(&"clock") == -1 and gear.spend(&"clock", 1) == 0 and not gear.can_use(&"clock"), "Clock cannot be used/repaired/spent")
	for tool: StringName in gear.TOOLS:
		gear.reset_state()
		var cap := gear.capacity(tool)
		expect(gear.remaining(tool) == cap and gear.condition(tool) == 1 and gear.stage(tool) == 0, "Full condition starts correctly: " + String(tool))
		gear.spend(tool, cap / 16)
		var token := gear.begin_repair(tool)
		expect(gear.stage(tool) == 3 and not gear.can_use(tool) and gear.spend(tool, 1) == 0, "Repair blocks firing without changing condition")
		expect(is_equal_approx(gear.complete_step(tool, token), cap / 16) and gear.is_full(tool), "Light wear repairs only missing fraction")
		gear.end_repair(token)
		gear.spend(tool, cap * 29 / 32)
		token = gear.begin_repair(tool)
		expect(gear.stage(tool) == 0 and is_equal_approx(gear.complete_step(tool, token), cap * 5 / 32) and gear.stage(tool) == 1, "Heavy wear completes first exact checkpoint")
		gear.complete_step(tool, token)
		gear.end_repair(token)
		expect(gear.condition(tool) == .5 and gear.stage(tool) == 2 and gear.complete_step(tool, token) == 0, "Closing retains completed work, rejects stale work")
		expect(other.is_full(tool), "Mutable condition is instance local")
	gear.reset_state()
	gear.spend(&"ring", 12)
	gear.spend(&"beam", 32)
	var old := gear.begin_repair(&"ring")
	var token := gear.begin_repair(&"beam")
	gear.end_repair(old)
	expect(gear.repairing == &"beam" and gear.complete_step(&"beam", old) == 0, "Stale panel cannot cancel or finish a replacement session")
	gear.end_repair(token)
	var snapshot := gear.capture_state()
	expect(snapshot.remaining.size() == 3 and not snapshot.remaining.has("clock"), "Snapshot contains three condition values only")
	var copy: Dictionary = bytes_to_var(var_to_bytes(snapshot))
	snapshot.remaining.ring = 0
	expect(gear.remaining(&"ring") == 12, "Snapshot mutation cannot change live condition")
	old = gear.begin_repair(&"ring")
	gear.restore_state(copy)
	expect(gear.repairing == &"" and not gear.is_session_active(old) and gear.complete_step(&"ring", old) == 0, "Restore invalidates all held repair sessions")
	token = gear.begin_repair(&"ring")
	gear.end_repair(old)
	expect(gear.is_session_active(token, &"ring") and gear.complete_step(&"ring", token) == 6, "New session survives a stale closing callback")
	gear.end_repair(token)
	gear.reset_state()
	gear.set_training_protection([&"beam", &"clock", &"beam"])
	expect(gear.training_protection == [&"beam"] and gear.spend(&"beam", 4) == 4 and gear.condition(&"beam") == 1, "Training protection accepts real use, only for valid tools")
	gear.restore_state(copy)
	expect(gear.is_training_protected(&"beam"), "Rewind never restores training policy")
	gear.set_training_protection([])
	expect(gear.spend(&"beam", 4) == 4 and gear.remaining(&"beam") == 28, "Disabling protection restores normal wear")
	gear.reset_state()
	gear.spend(&"cone", 200)
	expect(gear.remaining(&"cone") == 0 and not gear.can_use(&"cone"), "Continuous spending saturates at zero")
	var settings: WeaponConditionSettings = gear.settings.duplicate()
	settings.ring_capacity = 40
	settings.repair_steps = 5
	var custom := WeaponEquipment.new(settings)
	custom.spend(&"ring", 40)
	token = custom.begin_repair(&"ring")
	expect(custom.repair_steps == 5 and custom.complete_step(&"ring", token) == 8 and gear.capacity(&"ring") == 24, "Inspector condition resource changes real capacity/checkpoints without leaking to other actors")
	var time := TimeController.new()
	time.auto_advance = false
	root.add_child(time)
	time.begin_attempt()
	gear.spend(&"beam", 64)
	token = gear.begin_repair(&"beam")
	var meter_before := time.meter
	if time.try_spend_repair_checkpoint(): gear.complete_step(&"beam", token)
	expect(gear.remaining(&"beam") == 16 and time.meter == meter_before - time.settings.repair_cost_per_checkpoint, "Input owner atomically pays time before condition checkpoint")
	time.try_spend(time.meter)
	var condition_before := gear.remaining(&"beam")
	if time.try_spend_repair_checkpoint(): gear.complete_step(&"beam", token)
	expect(gear.remaining(&"beam") == condition_before and not time.emergency_active, "Insufficient voluntary time gives no condition progress or emergency")
	time.free()
	print(JSON.stringify({"status":"passed" if failures.is_empty() else "failed","checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
